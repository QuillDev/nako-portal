{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the app's own connect page can call the shell; the portal it loads gets just its window controls (added at runtime for the chosen server).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-start",
    "allow-connect",
    "allow-pane",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
